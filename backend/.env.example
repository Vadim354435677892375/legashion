# === База данных (Neon Postgres) ===
# Пуловое соединение (через pgbouncer) — используется приложением в рантайме.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/legashion?sslmode=require"
# Прямое соединение (без pgbouncer) — нужно только для миграций (prisma migrate).
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/legashion?sslmode=require"

# === Сервер ===
PORT=4000
# Через запятую — список источников, которым разрешено ходить в API (домен фронтенда).
# ВАЖНО: в продакшене (NODE_ENV=production, на Vercel выставляется само) пустой список
# означает «никому», а не «всем». Локально при пустом значении разрешено всё.
CORS_ORIGIN="http://localhost:5173,https://legashion.vercel.app"

# === Админ-авторизация (JWT) ===
# Минимум 32 символа. Сервер не запустится (а вход в админку вернёт 500) с коротким
# секретом или с заглушкой. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Смена JWT_SECRET мгновенно разлогинивает всех админов.
JWT_SECRET=""
# Срок жизни токена админа. По умолчанию 12h; больше суток ставить не стоит.
JWT_EXPIRES_IN="12h"

# === DaData (подсказки адреса для России) — теперь спрятан за бэкендом ===
DADATA_TOKEN="вставь_сюда_свой_ключ"

# === Yandex Cloud Object Storage (фото товаров) ===
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET="legashion-media"
S3_ACCESS_KEY_ID="вставь_сюда"
S3_SECRET_ACCESS_KEY="вставь_сюда"
# Публичный базовый URL, по которому отдаются файлы бакета (сам бакет или CDN перед ним)
S3_PUBLIC_URL="https://storage.yandexcloud.net/legashion-media"

# === Telegram-уведомления о новых заказах ===
TELEGRAM_BOT_TOKEN="вставь_сюда_токен_бота"
TELEGRAM_CHAT_ID="вставь_сюда_id_чата_или_канала"

# === Email-уведомления о новых заказах (SMTP) ===
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="orders@legashion.ru"
SMTP_PASS="вставь_сюда_пароль_приложения"
ADMIN_EMAIL="admin@legashion.ru"
